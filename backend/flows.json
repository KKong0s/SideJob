[
  { "id": "tab_auth", "type": "tab", "label": "Auth", "disabled": false, "info": "/api/auth/... : register, login, Google Sign-In, onboarding" },
  { "id": "tab_seeker", "type": "tab", "label": "Seeker", "disabled": false, "info": "/api/seeker/... : seeker profile, applications, saved jobs" },
  { "id": "tab_shop", "type": "tab", "label": "Shop", "disabled": false, "info": "/api/shop/... : shop profile, verification upload, jobs, applicants" },
  { "id": "tab_admin", "type": "tab", "label": "Admin", "disabled": false, "info": "/api/admin/... : shop verification, users, jobs, reports, categories, audit log" },
  { "id": "tab_jobs", "type": "tab", "label": "Jobs (public)", "disabled": false, "info": "/api/jobs/... : search and job detail" },
  { "id": "tab_geo", "type": "tab", "label": "Geo", "disabled": false, "info": "/api/geo/... : regions, provinces, districts" },
  { "id": "tab_notifications", "type": "tab", "label": "Notifications", "disabled": false, "info": "In-app notifications" },
  { "id": "tab_scheduled", "type": "tab", "label": "Scheduled", "disabled": false, "info": "Timed jobs, e.g. closing expired job posts at midnight" },
  { "id": "tab_system", "type": "tab", "label": "System", "disabled": false, "info": "Health check and shared infrastructure" },

  {
    "id": "cfg_mysql_sidejob",
    "type": "MySQLdatabase",
    "name": "SideJob MySQL",
    "host": "${DB_HOST}",
    "port": "${DB_PORT}",
    "db": "${DB_NAME}",
    "tz": "+07:00",
    "charset": "UTF8MB4"
  },

  { "id": "cmt_auth", "type": "comment", "z": "tab_auth", "name": "Phase 1: /api/auth/*", "info": "", "x": 140, "y": 40, "wires": [] },
  { "id": "cmt_seeker", "type": "comment", "z": "tab_seeker", "name": "/api/seeker/* (role: seeker)", "info": "", "x": 150, "y": 40, "wires": [] },
  { "id": "cmt_shop", "type": "comment", "z": "tab_shop", "name": "/api/shop/* (role: shop)", "info": "", "x": 140, "y": 40, "wires": [] },
  { "id": "cmt_admin", "type": "comment", "z": "tab_admin", "name": "/api/admin/* (role: admin)", "info": "", "x": 140, "y": 40, "wires": [] },
  { "id": "cmt_jobs", "type": "comment", "z": "tab_jobs", "name": "/api/jobs/* (public)", "info": "", "x": 130, "y": 40, "wires": [] },
  { "id": "cmt_geo", "type": "comment", "z": "tab_geo", "name": "/api/geo/* (public)", "info": "", "x": 130, "y": 40, "wires": [] },
  { "id": "cmt_notifications", "type": "comment", "z": "tab_notifications", "name": "Notification API and helpers", "info": "", "x": 150, "y": 40, "wires": [] },
  { "id": "cmt_scheduled", "type": "comment", "z": "tab_scheduled", "name": "Daily midnight jobs (Asia/Bangkok)", "info": "", "x": 170, "y": 40, "wires": [] },

  {
    "id": "in_health",
    "type": "http in",
    "z": "tab_system",
    "name": "GET /api/health",
    "url": "/api/health",
    "method": "get",
    "upload": false,
    "swaggerDoc": "",
    "x": 140,
    "y": 80,
    "wires": [["fn_health_query"]]
  },
  {
    "id": "fn_health_query",
    "type": "function",
    "z": "tab_system",
    "name": "Build health query",
    "func": "msg.topic = \"SELECT DATE_FORMAT(NOW(), '%Y-%m-%d %H:%i:%s') AS server_time, (SELECT COUNT(*) FROM provinces) AS provinces\";\nmsg.payload = [];\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 360,
    "y": 80,
    "wires": [["db_health"]]
  },
  {
    "id": "db_health",
    "type": "mysql",
    "z": "tab_system",
    "mydb": "cfg_mysql_sidejob",
    "name": "Query database",
    "x": 560,
    "y": 80,
    "wires": [["fn_health_response"]]
  },
  {
    "id": "fn_health_response",
    "type": "function",
    "z": "tab_system",
    "name": "Format health response",
    "func": "const row = msg.payload[0];\nmsg.statusCode = 200;\nmsg.payload = {\n    status: 'ok',\n    database: 'connected',\n    provinces: row.provinces,\n    time: row.server_time\n};\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 780,
    "y": 80,
    "wires": [["out_health"]]
  },
  {
    "id": "out_health",
    "type": "http response",
    "z": "tab_system",
    "name": "Send response",
    "statusCode": "",
    "headers": {},
    "x": 990,
    "y": 80,
    "wires": []
  },
  {
    "id": "catch_system",
    "type": "catch",
    "z": "tab_system",
    "name": "Catch System errors",
    "scope": null,
    "uncaught": false,
    "x": 150,
    "y": 160,
    "wires": [["fn_system_error"]]
  },
  {
    "id": "fn_system_error",
    "type": "function",
    "z": "tab_system",
    "name": "Format error response",
    "func": "// Standard error body used across the whole API: { error: { code, message } }\nconst status = Number(msg.statusCode) >= 400 ? Number(msg.statusCode) : 500;\nnode.warn(`${msg.req ? msg.req.method + ' ' + msg.req.originalUrl : ''} -> ${status}: ${msg.error && msg.error.message}`);\nmsg.statusCode = status;\nmsg.payload = {\n    error: {\n        code: status === 500 ? 'INTERNAL_ERROR' : (msg.errorCode || 'ERROR'),\n        message: status === 500 ? 'เกิดข้อผิดพลาดในระบบ กรุณาลองใหม่' : (msg.errorMessage || 'เกิดข้อผิดพลาด')\n    }\n};\nreturn msg.res ? msg : null;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 380,
    "y": 160,
    "wires": [["out_system_error"]]
  },
  {
    "id": "out_system_error",
    "type": "http response",
    "z": "tab_system",
    "name": "Send error response",
    "statusCode": "",
    "headers": {},
    "x": 610,
    "y": 160,
    "wires": []
  }
]
