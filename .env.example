# Copy to .env and fill in. .env is git-ignored.
# Values containing "$" (bcrypt hashes) must be wrapped in single quotes.

# MySQL
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_PORT=3307
PHPMYADMIN_PORT=8081
DB_USER=sidejob_app
DB_PASSWORD=change-me-app

# Auth
JWT_SECRET=change-me-long-random-string
JWT_EXPIRES_IN=7d
GOOGLE_CLIENT_ID=

# Comma-separated origins allowed to call the API
# (ionic serve, ng serve, Capacitor iOS, Capacitor Android release, Capacitor Android debug)
CORS_ORIGINS=http://localhost:8100,http://localhost:4200,capacitor://localhost,https://localhost,http://localhost

# Node-RED editor login. Generate the hash with:
#   docker compose run --rm nodered node-red admin hash-pw
NODE_RED_PORT=1881
NODE_RED_ADMIN_USER=admin
NODE_RED_ADMIN_PASSWORD_HASH='$2b$08$replace.with.a.real.bcrypt.hash'
