{
  "name": "sidejob-frontend",
  "version": "0.0.1",
  "scripts": {
    "ng": "node scripts/ng.mjs",
    "start": "node scripts/ng.mjs serve",
    "share": "node scripts/ng.mjs serve --configuration share",
    "build": "node scripts/ng.mjs build",
    "build:android": "node scripts/ng.mjs build --configuration android && cap sync android",
    "android": "npm run build:android && cap open android",
    "watch": "node scripts/ng.mjs build --watch --configuration development",
    "test": "node scripts/ng.mjs test",
    "lint": "ng lint"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "~22.2.1",
    "@angular/compiler": "~22.2.1",
    "@angular/core": "~22.2.1",
    "@angular/forms": "~22.2.1",
    "@angular/platform-browser": "~22.2.1",
    "@angular/router": "~22.2.1",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/camera": "^8.2.5",
    "@capacitor/core": "^8.5.3",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@capgo/capacitor-social-login": "^8.5.17",
    "@fontsource/anuphan": "^5.3.0",
    "@fontsource/prompt": "^5.3.0",
    "@ionic/angular": "^9.0.0",
    "ionicons": "^8.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "~22.2.1",
    "@angular/cli": "~22.2.1",
    "@angular/compiler-cli": "~22.2.1",
    "@angular/language-service": "~22.2.1",
    "@capacitor/cli": "^8.5.3",
    "@ionic/angular-toolkit": "^13.0.0",
    "angular-eslint": "22.0.0",
    "eslint": "^10.10.0",
    "jsdom": "^26.0.0",
    "typescript": "~6.0.0",
    "typescript-eslint": "^8.61.0",
    "vitest": "~4.1.11"
  },
  "description": "SideJob - Ionic Angular app"
}
